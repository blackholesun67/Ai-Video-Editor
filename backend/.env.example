# ─── Google Gemini API Keys ──────────────────────────────────────────────────
# รองรับหลาย key — คั่นด้วยเครื่องหมาย "," (ไม่มีช่องว่าง)
# ถ้า key 1 quota หมด → ระบบจะ switch ไป key 2 อัตโนมัติ
#
# ขอ key ได้ฟรีจาก: https://aistudio.google.com/app/apikey
#
# ตัวอย่าง (1 key) : GEMINI_API_KEYS=AIzaSy....
# ตัวอย่าง (3 keys): GEMINI_API_KEYS=AIzaSy....,AIzaSy....,AIzaSy....
GEMINI_API_KEYS=your_gemini_api_key_here

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Auth + Database ─────────────────────────────────────────────────────────
# JWT_SECRET: คีย์เซ็น token — production ต้องตั้งเป็นค่าสุ่มยาว ๆ (สร้างด้วย: openssl rand -hex 32)
# ถ้า APP_ENV=production แล้วยังใช้ค่า default อ่อน ๆ ระบบจะหยุดทำงานทันที (กันเผลอ deploy)
JWT_SECRET=change-me-dev-secret
# อายุ token (ชั่วโมง) — ลดลงเพื่อกัน token รั่วใช้ได้นาน แลกกับต้อง login บ่อยขึ้น
JWT_TTL_HOURS=24
# จำกัดจำนวนครั้ง login ต่อ IP (รูปแบบ slowapi) — กัน brute-force รหัสผ่าน
LOGIN_RATE_LIMIT=10/minute
# ตั้ง production เพื่อบังคับให้ JWT_SECRET ต้องเป็นค่าจริง (dev ปล่อยว่างได้)
APP_ENV=
# DATABASE_URL: ปล่อยว่าง = ใช้ sqlite ไฟล์ในเครื่อง (dev). production ใช้ postgres:
#   postgresql+psycopg2://aive:<DB_PASSWORD>@postgres:5432/aivideo
DATABASE_URL=
# รหัสผ่าน postgres (docker-compose ใช้ตั้งค่า container + ประกอบ DATABASE_URL)
DB_PASSWORD=aivepass

# ─── Security (ปล่อยว่าง = ปิด สำหรับ dev / ตั้งค่า = เปิดสำหรับ production) ──────
# API key: ปล่อยว่าง = ไม่ต้อง auth. ตั้งค่า (คั่นด้วย ,) = /upload,/render ต้องส่ง header X-API-Key
# frontend ต้อง build ด้วย VITE_API_KEY ให้ตรงกับค่าตัวใดตัวหนึ่งนี้
API_KEYS=
# CORS: โดเมนที่อนุญาต (คั่นด้วย ,) — ปล่อยว่าง = localhost. deploy จริงใส่ https://yourdomain.com
ALLOWED_ORIGINS=
# Rate limit ต่อ IP (รูปแบบ slowapi เช่น 20/hour, 5/minute)
UPLOAD_RATE_LIMIT=20/hour
RENDER_RATE_LIMIT=60/hour

# ─── Cleanup ────────────────────────────────────────────────────────────────
# ลบ job เก่ากว่ากี่วัน (cleanup รันทุกวันตี 3 ผ่าน celery beat)
JOB_RETENTION_DAYS=7

# ─── Observability — Sentry (ปล่อยว่าง = ปิด) ────────────────────────────────
# ใส่ DSN จาก sentry.io → จับ exception ทั้ง FastAPI + Celery อัตโนมัติ
SENTRY_DSN=
SENTRY_ENV=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# ─── Prompt / AI processing ──────────────────────────────────────────────────
# DEBUG=1 → พิมพ์เนื้อหา transcript ลง log (dev เท่านั้น) / ว่าง = ไม่พิมพ์ (production กันเนื้อหารั่ว)
DEBUG=
# จำกัดขนาด transcript ที่ส่งเข้า Gemini (ตัวอักษร) — 0 = ไม่จำกัด (default)
# ตั้ง > 0 ถ้าอยากกัน token แพง/เกิน context สำหรับวิดีโอยาวมาก
MAX_TRANSCRIPT_CHARS=0
