      "text": "เวลาที่ใช้ application"
    },
    {
      "start": 9.838,
      "end": 11.203,
      "orig_start": 9.818,
      "orig_end": 11.203,
      "text": "แผนที่หลักการทำงานคือ"
    },
    {
      "start": 11.223,
      "end": 13.458,
      "orig_start": 11.203,
      "orig_end": 13.458,
      "text": "โทรศัพท์จะรับสัญญาณ"
    },
    {
      "start": 13.478,
      "end": 15.376,
      "orig_start": 13.458,
      "orig_end": 15.376,
      "text": "จากดาวเทียมหลายดวงจากนั้น"
    },
    {
      "start": 15.396,
      "end": 16.976,
      "orig_start": 15.376,
      "orig_end": 16.976,
      "text": "โทรศัพท์"
    },
    {
      "start": 31.6,
      "end": 33.2,
      "orig_start": 31.6,
      "orig_end": 33.2,
      "text": "จะนำข้อมูลที่ได้มาคำนวณ"
    },
    {
      "start": 33.22,
      "end": 35.633,
      "orig_start": 33.2,
      "orig_end": 35.633,
      "text": "ตำแหน่งหาจุดที่"
    },
    {
      "start": 35.653,
      "end": 40.033,
      "orig_start": 35.633,
      "orig_end": 40.033,
      "text": "เราอยู่ในปัจจุบันเมื่อ"
    },
    {
      "start": 50.062,
      "end": 52.58,
      "orig_start": 50.062,
      "orig_end": 52.58,
      "text": "ระบบรู้ว่าเราอยู่ตรงไหนแผนที่ก็"
    },
    {
      "start": 55.15,
      "end": 57.258,
      "orig_start": 55.15,
      "orig_end": 57.258,
      "text": "เช่นการแสดงตำแหน่งปัจจุบัน"
    },
    {
      "start": 57.278,
      "end": 61.458,
      "orig_start": 57.258,
      "orig_end": 61.458,
      "text": "การหาเส้นทางหาสถานที่"
    },
    {
      "start": 62.206,
      "end": 65.206,
      "orig_start": 62.206,
      "orig_end": 65.206,
      "text": "ใกล้เคียงถึงแม้"
    },
    {
      "start": 82.806,
      "end": 83.951,
      "orig_start": 82.806,
      "orig_end": 83.951,
      "text": "ผู้ใช้จะเห็นเป็นเพียงจุด"
    },
    {
      "start": 83.971,
      "end": 86.223,
      "orig_start": 83.951,
      "orig_end": 86.223,
      "text": "เล็กๆบนหน้าจอแต่เบื้องหลัง"
    },
    {
      "start": 86.243,
      "end": 87.072,
      "orig_start": 86.223,
      "orig_end": 87.072,
      "text": "มีการรับส่งสัญญาณ"
    },
    {
      "start": 87.092,
      "end": 88.672,
      "orig_start": 87.072,
      "orig_end": 88.672,
      "text": "และคำนวณหลายขั้นตอนทั้งหมด"
    },
    {
      "start": 88.692,
      "end": 90.653,
      "orig_start": 88.672,
      "orig_end": 90.653,
      "text": "นี้เกิดขึ้นอย่างรวดเร็วทำให้"
    },
    {
      "start": 90.673,
      "end": 92.139,
      "orig_start": 90.653,
      "orig_end": 92.139,
      "text": "เราสามารถใช้ GPS ได้ใน"
    },
    {
      "start": 92.159,
      "end": 94.376,
      "orig_start": 92.139,
      "orig_end": 94.376,
      "text": "ชีวิตประจำวันได้ทันทีครับ"
    },
    {
      "start": 94.396,
      "end": 94.87,
      "orig_start": 94.376,
      "orig_end": 94.87,
      "text": "ขอบคุณครับ"
    }
