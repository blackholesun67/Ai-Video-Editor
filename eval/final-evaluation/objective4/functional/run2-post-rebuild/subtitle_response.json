{"phrases":[{"start":1.7,"end":4.62,"orig_start":1.7,"orig_end":4.62,"text":"วี 02 ทดสอบสวัสดีครับ"},{"start":4.76,"end":6.04,"orig_start":4.76,"orig_end":6.04,"text":"วันนี้ผมจะมาพูดเกี่ยวกับพื้น"},{"start":6.06,"end":7.36,"orig_start":6.04,"orig_end":7.36,"text":"ธานการลงธุณในฮุนครับ"},{"start":7.38,"end":9.22,"orig_start":7.36,"orig_end":9.22,"text":"เวลาพูดถึงฮุนหลายคนอาจจะ"},{"start":9.24,"end":10.88,"orig_start":9.22,"orig_end":10.88,"text":"นึกถึงกราฟราคาที่มีทั้งขึ้น"},{"start":10.9,"end":12.18,"orig_start":10.88,"orig_end":12.18,"text":"แล้วลงแต่จริงๆ"},{"start":12.2,"end":14.12,"orig_start":12.18,"orig_end":14.12,"text":"แล้วฮุนไม่ได้มีแค่เรื่องของ"},{"start":14.14,"end":14.94,"orig_start":14.12,"orig_end":14.94,"text":"ราคาครับ"},{"start":14.96,"end":16.54,"orig_start":14.94,"orig_end":16.54,"text":"เพราะเบื่องหลังราคาคือธุรกิต"},{"start":16.56,"end":18.55,"orig_start":16.54,"orig_end":18.55,"text":"ของบริศัตร์เวลาที่เราจะเลือก"},{"start":18.57,"end":22.15,"orig_start":18.55,"orig_end":22.15,"text":"ซื้อฮุนซักฮุนหนึ่ง"},{"start":34.38,"end":34.92,"orig_start":34.38,"orig_end":34.92,"text":"เรากำลังเล"},{"start":34.94,"end":35.7,"orig_start":34.38,"orig_end":35.7,"text":"บริสัตรขาสิ่งข้าอะไร"},{"start":36.16,"end":36.94,"orig_start":36.16,"orig_end":36.94,"text":"มีทุกข้าเป็นใคร"},{"start":37.36,"end":38.14,"orig_start":37.36,"orig_end":38.14,"text":"หลายได้มาจากไหน"},{"start":38.44,"end":40.28,"orig_start":38.44,"orig_end":40.28,"text":"และบริสัตรมีคู่แข่งหรือเปล่า ?"},{"start":40.42,"end":41.38,"orig_start":40.42,"orig_end":41.38,"text":"นอกจากเรื่องโทรกิจ"},{"start":41.4,"end":43.38,"orig_start":41.38,"orig_end":43.38,"text":"แล้วเราก็อดูผลประกอบการของบ"},{"start":43.4,"end":45.76,"orig_start":43.38,"orig_end":45.76,"text":"ริสัตรด้วยเช่นหลายได้กำลาย"},{"start":46.04,"end":48.84,"orig_start":46.04,"orig_end":48.84,"text":"และข้าชิจัยข้อ"},{"start":51.64,"end":53.1,"orig_start":51.64,"orig_end":53.1,"text":"มุ่นพวกนี้ช่วยให้เราเห็นภาพว่า"},{"start":53.12,"end":54.4,"orig_start":53.1,"orig_end":54.4,"text":"บริสัตรกำลังนำเนินโทรกิจอะไร"},{"start":54.42,"end":56.68,"orig_start":54.4,"orig_end":56.68,"text":"ถึงแม้บริสัตรกกำ"},{"start":56.7,"end":60.08,"orig_start":56.68,"orig_end":60.08,"text":"ลายดีหรือไม่ได้กำ"},{"start":67.98,"end":69.48,"orig_start":67.98,"orig_end":69.48,"text":"ตัวอย่างเช่นถ้าบริสัตว์"},{"start":69.5,"end":70.6,"orig_start":69.48,"orig_end":70.6,"text":"ประกาศกำลายเอามาได้ดี"},{"start":70.86,"end":72.7,"orig_start":70.86,"orig_end":72.7,"text":"แต่ตลาดหวังไว้สูงกว่าระคา"},{"start":72.72,"end":74.9,"orig_start":72.7,"orig_end":74.9,"text":"ดั้นระคาหุ่นก็อาจจะตก"},{"start":74.92,"end":77.23,"orig_start":74.9,"orig_end":77.23,"text":"อีกเรื่องที่สำคัญคือความ"},{"start":77.25,"end":77.67,"orig_start":77.23,"orig_end":77.67,"text":"เสียงครับ"},{"start":79.59,"end":81.89,"orig_start":79.59,"orig_end":81.89,"text":"การลงทุนในหุ่นมีโอกาศขัดทุน"},{"start":81.91,"end":84.43,"orig_start":81.89,"orig_end":84.43,"text":"เพราะระคาหุ่นสามารถลดลงได้"},{"start":84.45,"end":85.93,"orig_start":90.23,"orig_end":91.73,"text":"เพราะฉะนั้นคนที่ลงทุนในหุ่น"},{"start":86.07,"end":87.35,"orig_start":91.87,"orig_end":93.15,"text":"ควรเข้าใจว่าตัวเองกำลังลงทุน"},{"start":87.37,"end":89.07,"orig_start":93.15,"orig_end":94.87,"text":"ในอะไรและควรพิจนาว"},{"start":89.17,"end":90.69,"orig_start":94.97,"orig_end":96.49,"text":"ในรับความผันผ่วนของราคาคุณ"},{"start":90.71,"end":91.55,"orig_start":96.49,"orig_end":97.35,"text":"ได้มากแค่ไหน"},{"start":92.09,"end":93.79,"orig_start":97.89,"orig_end":99.59,"text":"ถ้าสรุปง่ายง่ายการลังถูกในคุณ"},{"start":94.53,"end":96.23,"orig_start":100.33,"orig_end":102.03,"text":"ไม่ได้มีดีแค่ว่าพรุ่งนี้ราคา"},{"start":96.25,"end":97.29,"orig_start":102.03,"orig_end":103.09,"text":"จะขึ้นเลยจะลง"},{"start":98.53,"end":100.25,"orig_start":104.33,"orig_end":106.05,"text":"แต่ควรเริ่มจากการเข้าใจทุกระ"},{"start":100.27,"end":102.37,"orig_start":106.05,"orig_end":108.17,"text":"กิษดูข้อมูลที่เกียวข้อง"},{"start":102.49,"end":104.51,"orig_start":108.29,"orig_end":110.31,"text":"และทางวางเข้าใจความเสียงด้วยครับ"},{"start":104.53,"end":105.03,"orig_start":110.31,"orig_end":110.83,"text":"ขอบคุณครับ"}]}