{"segments": [{"start": 0.0, "end": 69.91}, {"start": 75.72, "end": 143.24}], "edited_phrases": [{"start": 1.09, "end": 3.35, "orig_start": 1.09, "orig_end": 3.35, "text": "V 04 คิดวิโลทศอบผู้สำพาด [แก้ไขโดยเทสต์ 4A-v1]"}, {"start": 3.43, "end": 5.64, "orig_start": 3.43, "orig_end": 5.64, "text": "ผู้สำหรับถ้าให้คุณ"}, {"start": 5.66, "end": 6.6, "orig_start": 5.64, "orig_end": 6.6, "text": "อาทิบายคำว่าหุ่น"}, {"start": 7.12, "end": 8.82, "orig_start": 7.12, "orig_end": 8.82, "text": "แบบง่ายง่ายคุณอาทิบายว่า"}, {"start": 8.84, "end": 9.32, "orig_start": 8.82, "orig_end": 9.32, "text": "ยังไงครับ"}, {"start": 10.51, "end": 13.71, "orig_start": 10.51, "orig_end": 13.71, "text": "หุ่นก็คืออ่า ..."}, {"start": 13.99, "end": 15.27, "orig_start": 13.99, "orig_end": 15.27, "text": "เป็นส่วนหนึ่งของบริสัตว์ครับ"}, {"start": 16.25, "end": 18.35, "orig_start": 16.25, "orig_end": 18.35, "text": "หมายความว่ายังไงครับ"}, {"start": 18.37, "end": 20.07, "orig_start": 18.35, "orig_end": 20.07, "text": "คือถ้าเราเข้าไปซื้อหุ่นของบ"}, {"start": 20.09, "end": 21.75, "orig_start": 20.07, "orig_end": 21.75, "text": "ริสัตว์เราก็จะมีความเป็นเจ้า"}, {"start": 21.77, "end": 23.01, "orig_start": 21.75, "orig_end": 23.01, "text": "ของบริสัตว์นั้นตามสัส"}, {"start": 23.03, "end": 25.23, "orig_start": 23.01, "orig_end": 25.23, "text": "ส่วนหุ่นที่เราถือครับ"}, {"start": 25.25, "end": 26.23, "orig_start": 25.23, "orig_end": 26.23, "text": "แล้ว"}, {"start": 32.7, "end": 35.34, "orig_start": 32.7, "orig_end": 35.34, "text": "แล้วก็เงินปันผลด้วยครับ"}, {"start": 35.36, "end": 37.44, "orig_start": 35.34, "orig_end": 37.44, "text": "ในกรณีที่บริสัตว์มีการจ่าย"}, {"start": 37.46, "end": 38.64, "orig_start": 37.44, "orig_end": 38.64, "text": "เงินปันผลนะครับ"}, {"start": 39.47, "end": 41.55, "orig_start": 39.47, "orig_end": 41.55, "text": "สมุดผมซื้อหุนที่ราคา 100 บาท"}, {"start": 41.57, "end": 43.83, "orig_start": 41.55, "orig_end": 43.83, "text": "แล้วราคาขึ้นเป็น 120 บาท"}, {"start": 43.85, "end": 45.33, "orig_start": 43.83, "orig_end": 45.33, "text": "แบบนี้ผมได้กำลายแน่นอนไหมครับ"}, {"start": 45.81, "end": 47.65, "orig_start": 45.81, "orig_end": 47.65, "text": "กำลายแน่นอนครับ"}, {"start": 47.83, "end": 49.03, "orig_start": 47.83, "orig_end": 49.03, "text": "ว่าราคาขึ้นมา 20 บาท"}, {"start": 49.05, "end": 53.07, "orig_start": 49.03, "orig_end": 53.07, "text": "แล้วเดี๋ยวก่อนนะครับผม"}, {"start": 53.09, "end": 54.65, "orig_start": 53.07, "orig_end": 54.65, "text": "ขอแก้คำตอดนิดหนึ่งครับ"}, {"start": 55.29, "end": 57.51, "orig_start": 55.29, "orig_end": 57.51, "text": "ถ้าเรายังไม่ได้ขายหุนเรา"}, {"start": 57.53, "end": 58.69, "orig_start": 57.51, "orig_end": 58.69, "text": "อาดเรียกว่าเป็นกำลายทิป"}, {"start": 61.91, "end": 63.83, "orig_start": 61.91, "orig_end": 63.83, "text": "ลือกำลายจากราคาที่เพิ่มขึ้นครับ"}, {"start": 63.85, "end": 65.67, "orig_start": 63.83, "orig_end": 65.67, "text": "เพราะราคาสามารถเปลี่ยนแปลง"}, {"start": 65.69, "end": 66.93, "orig_start": 65.67, "orig_end": 66.93, "text": "ได้ตลอดเวลาครับ"}, {"start": 67.09, "end": 68.95, "orig_start": 67.09, "orig_end": 68.95, "text": "ถ้าเราซื้อที่ 100 บาท"}, {"start": 68.97, "end": 69.91, "orig_start": 68.95, "orig_end": 69.91, "text": "และราคาเปลี่ยนเป็น 120"}, {"start": 70.29, "end": 71.63, "orig_start": 76.1, "orig_end": 77.44, "text": "เราซื้อคือ 100 [แก้ไขโดยเทสต์ 4A-v1]"}, {"start": 71.91, "end": 73.57, "orig_start": 77.72, "orig_end": 79.38, "text": "บาทและราคาขึ้นไปเป็น 120"}, {"start": 73.93, "end": 75.51, "orig_start": 79.74, "orig_end": 81.32, "text": "บาทจังนั้นเราขายที่ 120"}, {"start": 75.81, "end": 77.67, "orig_start": 81.62, "orig_end": 83.48, "text": "บาทแบบนั้นถึงจะเรียกกำลายจาก"}, {"start": 77.69, "end": 79.25, "orig_start": 83.48, "orig_end": 85.06, "text": "สัตว์ส่วนต่างของราคาครับ"}, {"start": 80.37, "end": 81.75, "orig_start": 86.18, "orig_end": 87.56, "text": "แล้วทำไมราคาคุณขึ้น"}, {"start": 81.77, "end": 82.49, "orig_start": 87.56, "orig_end": 88.3, "text": "แล้วลงละครับ"}, {"start": 83.19, "end": 85.15, "orig_start": 89.0, "orig_end": 90.96, "text": "ก็มีหลายปัดใ"}, {"start": 86.01, "end": 87.33, "orig_start": 91.82, "orig_end": 93.14, "text": "เช่นผ่อนประกอบการข้างมาริ"}, {"start": 87.35, "end": 88.29, "orig_start": 93.14, "orig_end": 94.1, "text": "สัตว์ข้าวสาร"}, {"start": 88.75, "end": 90.19, "orig_start": 94.56, "orig_end": 96.0, "text": "ความคลับหวังของนักลงทุน"}, {"start": 90.53, "end": 91.43, "orig_start": 96.34, "orig_end": 97.24, "text": "สับพับศาษาคิด"}, {"start": 91.92, "end": 94.04, "orig_start": 97.73, "orig_end": 99.85, "text": "รีวิวความต้องการซื้อขายในตลาดครับ"}, {"start": 95.24, "end": 96.46, "orig_start": 101.05, "orig_end": 102.27, "text": "ถ้าบริสัตว์มีกำลายเพิ่มขึ้น"}, {"start": 96.82, "end": 97.9, "orig_start": 102.63, "orig_end": 103.71, "text": "ราคาหูนต้องขึ้นไหมครับ"}, {"start": 97.92, "end": 99.82, "orig_start": 103.71, "orig_end": 105.63, "text": "ตั้งขึ้นครับ"}, {"start": 99.84, "end": 101.9, "orig_start": 105.63, "orig_end": 107.71, "text": "เพราะบริสัตว์กำลายดีขึ้น"}, {"start": 102.89, "end": 105.17, "orig_start": 108.7, "orig_end": 110.98, "text": "อ่าจริงๆก็ไม่จำเป็นต้องขึ้น"}, {"start": 105.19, "end": 106.13, "orig_start": 110.98, "orig_end": 111.94, "text": "สมือไปครับ"}, {"start": 106.15, "end": 107.71, "orig_start": 111.94, "orig_end": 113.52, "text": "เพราะราคาหูนไม่ได้ดูแค่"}, {"start": 107.73, "end": 109.15, "orig_start": 113.52, "orig_end": 114.96, "text": "ผลประกอบการในปัจจุบัน"}, {"start": 109.43, "end": 111.13, "orig_start": 115.24, "orig_end": 116.94, "text": "แต่ยังขึ้นอยู่กับสภาพตลาด"}, {"start": 111.19, "end": 112.23, "orig_start": 117.0, "orig_end": 118.04, "text": "และความขัดหวังของนักล"}, {"start": 114.03, "end": 116.09, "orig_start": 119.84, "orig_end": 121.9, "text": "ถ้าอย่างนั้นคนที่ร้อมนุ่งถุน"}, {"start": 116.19, "end": 117.39, "orig_start": 122.0, "orig_end": 123.2, "text": "ควรทำอะไรเป็นรับแรกครับ"}, {"start": 119.45, "end": 122.41, "orig_start": 125.26, "orig_end": 128.22, "text": "ความคิดมากควรเริ่มจากการศึกษา"}, {"start": 123.28, "end": 124.64, "orig_start": 129.09, "orig_end": 130.45, "text": "สิ่งที่เราสนใจก่อนครับ"}, {"start": 124.84, "end": 126.02, "orig_start": 130.65, "orig_end": 131.83, "text": "ว่าบริสัตว์นั้นทำทุกระกิษ"}, {"start": 126.04, "end": 128.0, "orig_start": 131.83, "orig_end": 133.81, "text": "อะไรรายได้มาจากไหนมีจุดแข็ง"}, {"start": 128.02, "end": 128.8, "orig_start": 133.81, "orig_end": 134.61, "text": "หรือความเสียงอะไร"}, {"start": 129.26, "end": 131.56, "orig_start": 135.07, "orig_end": 137.37, "text": "แล้วค่อยพิจารณาซื้อฮุนว่า"}, {"start": 131.58, "end": 133.3, "orig_start": 137.37, "orig_end": 139.11, "text": "ฮุนั้นตรงกับป้องหมายของเราไหมครับ"}, {"start": 134.07, "end": 135.67, "orig_start": 139.88, "orig_end": 141.48, "text": "โอเคครับ"}, {"start": 135.95, "end": 137.43, "orig_start": 141.76, "orig_end": 143.24, "text": "ขอจบการสัมพัติเถอะนี้ขอบคุณครับ"}]}
