+def _vad_silence_gaps(voice_segments: list[dict], transcript: list[dict],
+                      total_duration: float, min_gap: float) -> tuple[list[dict], list[dict], int]:
+    """
+    ช่วงเงียบ "ภายใน" ท่อนถอดเสียง — จาก VAD (ช่องว่างระหว่าง voice_segments ≥ min_gap) ที่ผ่าน guard
+
+    ทำไมต้องมี: Whisper รวมหลายประโยคไว้ท่อนเดียวได้ (p90 = 20 วิ) ความเงียบกลางท่อนจึงไม่โผล่เป็น
+    ช่องว่างระหว่างท่อน — _long_silence_gaps เดิมมองไม่เห็น ทั้งที่ get_silence_gaps() (vad_logic)
+    คำนวณช่วงเหล่านี้ได้อยู่แล้วแต่ไม่มีที่ใดเรียกใช้เลย
+
+    guard: ความเงียบต้องไม่มีเสียงพูดตามหลักฐานทั้งสองแหล่ง — VAD ไม่เห็นเสียงพูด "และ" Whisper ไม่มีคำในช่วงนั้น
+    (วัดจริง 7 จาก 14 ช่วงของ VAD มีคำ Whisper ทับที่ขอบ 0.0-0.8 วิ) → หักช่วงที่ [start, end] ของคำทับออก
+    แล้วเก็บเศษที่ยังยาว ≥ min_gap ; ท่อนที่ไม่มี words[] ตรวจซ้ำไม่ได้ จึงพึ่ง VAD อย่างเดียว
+
+    คืน: (ช่วงที่ใช้ได้, ช่วงที่ทิ้งพร้อมเหตุผล, จำนวนช่วงเงียบดิบจาก VAD) — รูปแบบ {"start","end","dur"} เหมือน _long_silence_gaps
+    """
+    try:
+        # import ตอนเรียก ไม่ใช่ตอนโหลดโมดูล: vad_logic โหลดโมเดล Silero ทันทีที่ import
+        # (worker โหลดไว้แล้วผ่าน tasks.py) — ห้ามย้ายไปไว้บนสุดของไฟล์นี้
+        from core.vad_logic import get_silence_gaps
+    except Exception as e:
+        print(f"⚠️ [Silence Gap] ใช้ข้อมูล VAD ไม่ได้ ({e}) — ใช้เฉพาะช่องว่างระหว่างท่อน")
+        return [], [], 0
+
+    words = sorted(
+        (float(w["start"]), max(float(w["end"]), float(w["start"])))
+        for s in transcript for w in (s.get("words") or [])
+        if w.get("start") is not None and w.get("end") is not None
+    )
+    usable: list[dict] = []
+    ignored: list[dict] = []
+    raw = get_silence_gaps(voice_segments, total_duration, min_gap=min_gap)
+    for g in raw:
+        a, b = float(g["start"]), float(g["end"])
+        free = [(a, b)]
+        for ws, we in words:
+            if we <= a or ws >= b:
+                continue
+            nxt = []
+            for fa, fb in free:
+                if we <= fa or ws >= fb:
+                    nxt.append((fa, fb))
+                    continue
+                if ws > fa:
+                    nxt.append((fa, ws))
+                if we < fb:
+                    nxt.append((we, fb))
+            free = nxt
+        kept = [(fa, fb) for fa, fb in free if fb - fa >= min_gap]
+        if not kept:
+            ignored.append({"start": round(a, 2), "end": round(b, 2), "dur": round(b - a, 2),
+                            "reason": "speech_inside(Whisper words)"})
+        for fa, fb in kept:
+            usable.append({"start": round(fa, 2), "end": round(fb, 2), "dur": round(fb - fa, 2)})
+    return usable, ignored, len(raw)
+
